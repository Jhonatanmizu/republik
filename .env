# ==============================================================================
# REPUBLIK — GLOBAL ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. PostgreSQL Database & Seeding Control
POSTGRES_USER=republik
POSTGRES_PASSWORD=republik_secret_2026
POSTGRES_DB=republik_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://republik:republik_secret_2026@localhost:5432/republik_db
DB_POOL_MAX=20
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true
SEED_DEFAULT_PASSWORD=Republik@2026
SEED_ADMIN_EMAIL=admin@republik.com.br
SEED_ADMIN_NAME="Super Admin Republik"
SEED_ADMIN_WHATSAPP="+55 (11) 99999-0000"

# 2. Backend Server, Ports & CORS
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3000
API_PREFIX=api
BODY_LIMIT=12mb
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BACKEND_URL=http://localhost:3001

# 3. JWT Authentication, Cookies & CSRF Protection
JWT_ACCESS_SECRET=republik-super-secret-access-key-2026-lgpd
JWT_REFRESH_SECRET=republik-super-secret-refresh-key-2026-lgpd
CSRF_SECRET=republik-csrf-double-submit-secret-2026
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
OTP_TTL_SECONDS=600
EXPOSE_DEMO_OTP=true
COOKIE_ACCESS_NAME=republik_access_token
COOKIE_REFRESH_NAME=republik_refresh_token
COOKIE_CSRF_NAME=republik_csrf_token
COOKIE_SAME_SITE=lax

# 4. Rate Limiting / Throttling & Security Headers
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=15
CSP_CONNECT_SRC="'self' http://localhost:3000 http://localhost:3001"
HSTS_MAX_AGE_SECONDS=63072000

# 5. Email Strategy (resend | console)
EMAIL_DRIVER=resend
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=
RESEND_FROM_EMAIL="Republik <nao-responda@republik.com.br>"

# 6. Storage Strategy (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=republik-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# 7. Academic Verification & LGPD Metadata
RECOGNIZED_ACADEMIC_DOMAINS=usp.br,alumni.usp.br,ufba.br,uefs.br,ecomp.uefs.br,unicamp.br,dac.unicamp.br,ufmg.br,ufrj.br,unb.br,ufsc.br,edu.br
LGPD_CONTROLLER_NAME="Republik Tecnologia Universitária Ltda."
LGPD_DPO_EMAIL=privacidade@republik.com.br
DEFAULT_COVER_PHOTO_HOUSING=https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1000&q=80
DEFAULT_COVER_PHOTO_MARKETPLACE=https://images.unsplash.com/photo-1518455027359-f3f8164ba6bd?auto=format&fit=crop&w=1000&q=80

# 8. Observability (NestJS Observe)
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
OBSERVE_SERVICE_ID=republik-backend

# 9. Frontend Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=https://republik.com.br
NEXT_PUBLIC_APP_NAME=Republik
NEXT_PUBLIC_DPO_EMAIL=privacidade@republik.com.br
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511972331902
NEXT_PUBLIC_CSRF_COOKIE_NAME=republik_csrf_token
NEXT_PUBLIC_CSRF_HEADER_NAME=x-csrf-token

