                          "fontFamily": "Plus Jakarta Sans",
                          "fontSize": 19,
                          "fontWeight": "800"
                        },
                        {
                          "type": "text",
                          "id": "OCLgl",
                          "name": "Article Body",
                          "fill": "#334155",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Para garantir a segurança da comunidade, recursos como envio de mensagens e criação de anúncios exigem comprovação de vínculo universitário ativo via e-mail institucional (.edu.br, @usp.br, @unicamp.br, etc.) ou análise documental de Atestado de Matrícula vigente pela equipe de moderação.",
                          "lineHeight": 1.6,
